X_GLYPH_DEFINE("\\{/i}", GLYPH_VISIBILITY_MARKER, 1)
X_GLYPH_DEFINE("\\{dim}", GLYPH_DIM_MARKER, 1)
X_GLYPH_DEFINE("\\{/dim}", GLYPH_DIM_MARKER, 0)
X_GLYPH_DEFINE("\\{/color}", GLYPH_COLOR_MARKER, -1)
X_GLYPH_DEFINE("\\{role normal}", GLYPH_ROLE_MARKER, UI_TEXT_ROLE_NORMAL)
X_GLYPH_DEFINE("\\{role selected}", GLYPH_ROLE_MARKER, UI_TEXT_ROLE_SELECTED)
X_GLYPH_DEFINE("\\{role heading}", GLYPH_ROLE_MARKER, UI_TEXT_ROLE_HEADING)
X_GLYPH_DEFINE("\\{role value}", GLYPH_ROLE_MARKER, UI_TEXT_ROLE_VALUE)
X_GLYPH_DEFINE("\\{/role}", GLYPH_ROLE_MARKER, -1)
X_GLYPH_DEFINE("\\{secret 1}", GLYPH_SECRET, 0)
X_GLYPH_DEFINE("\\{secret 2}", GLYPH_SECRET, 1)
X_GLYPH_DEFINE("\\{secret 3}", GLYPH_SECRET, 2)
X_GLYPH_DEFINE("\\{small}", GLYPH_FONT_MARKER, 1)
X_GLYPH_DEFINE("\\{/small}", GLYPH_FONT_MARKER, 0)


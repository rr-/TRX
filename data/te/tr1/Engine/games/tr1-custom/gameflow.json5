{
    // NOTE: bad changes to this file may result in crashes.
    // Lines starting with double slashes are comments and are ignored.

    "engine": 1,
    "name": "Tomb Raider I Custom Level",

    "main_menu_picture": "title.webp",
    "savegame_file_fmt": "save_tr1_%02d.dat",

    "injections": [
        "injections/crystal.bin",
        "injections/font.bin",
        "injections/gun_glow.bin",
        "injections/lara_animations.bin",
        "injections/lara_extra.bin",
        "injections/lara_guns.bin",
        "injections/lara_outfits.bin",
        "injections/misc_sprites.bin",
        "injections/pda_model.bin",
        "injections/photo.bin",
        "injections/pickup_aid.bin",
        "injections/uzi_sfx.bin",
    ],

    "enable_tr2_item_drops": false,
    "convert_dropped_guns": false,

    "title": {
        "path": "title.phd",
        "music_track": 1,
        "sequence": [
            {"type": "display_picture", "path": "legal.webp", "legal": true, "display_time": 1, "fade_in_time": 1.0, "fade_out_time": 1.0},
            {"type": "exit_to_title"},
        ],
        "injections": [],
    },

    "levels": [
        // Level 0: Lara's Home
        {
            "path": "house.phd",
            "type": "gym",
            "music_track": 0,
            "lara_outfit": "tr1_gym",
            "sequence": [
                {"type": "loop_game"},
                {"type": "level_stats"},
                {"type": "exit_to_title"},
            ],
            "injections": [],
        },

        // Level 1: First level
        {
            "path": "level1.phd",
            "music_track": 2,
            "lara_outfit": "tr1_classic",
            "sequence": [
                {"type": "loop_game"},
                {"type": "level_stats"},
                {"type": "level_complete"},
            ],
            "injections": [],
        },
    ],

    "demos": [],
    "cutscenes": [],
    "fmvs": [],
    "hidden_config": [],
}
